<?xml version="1.0" ?>
<!--
  Apple9 (G16G) record layouts, from the 26A428 userspace driver.

  Evidence is cited as U:<address range> in AGXMetalG16G_B0; see README.md
  for provenance. Structs that are bit-identical to Apple8 are not repeated
  here: the Apple9 encoders use the cmdbuf.xml definitions directly.
-->
<genxml>
  <!--
    VDM stream. Native encoder: AGX::VDMEncoderGen5<AGX::HAL200::ESLEncoder,
    AGX::HAL200::DeviceConstants, AGX::HAL200::VsStateConfig>.

    Shared with Apple8: "VDM State" (first word), "VDM State Restart Index",
    "Index List" and its Buffer lo / Count / Instances / Start words,
    "PPP State", "VDM Stream Link".
  -->

  <!--
    The six words following a "VDM State" word of 0x4000002e (vertex shader
    word 0/1, vertex outputs and vertex unknown present). Built per vertex
    program variant by VertexProgramVariant::finalize, U:2148da144..2148da32c,
    and completed per draw in encodeAndEmitRenderState, U:2149c1c00..2149c1c64.
  -->
  <struct name="Apple9 VDM Vertex State" size="24">
    <!-- Two counts in 32-bit words derived from the compiler reply, read
         from the variant's state-load encoder at +0x12c and +0x128
         (U:2148d9f70..2148d9f8c). Their native names are unknown. -->
    <field name="State load count A" size="12" start="8" type="uint"/>
    <!-- From variant+0xf2c: bit 4 when bits 2 and 3 are clear, else 1
         (U:2148da154..2148da170). -->
    <field name="Unknown 31" size="1" start="31" type="bool"/>

    <field name="State load count B" size="18" start="35" type="uint"/>
    <!-- GPU address of the vertex state-load program, bits 38..47 and
         6..37 (U:2149c1c2c..2149c1c34, U:2149c1c5c). -->
    <field name="State load hi" size="10" start="54" type="hex"/>
    <field name="State load lo" size="32" start="64" type="hex"/>

    <!-- variant+0xf08; variant+0xf08 + variant+0xf10 + (variant+0xf00 != 0);
         variant+0xf10 (U:2148da188..2148da1a8). The first two are the Apple8
         "VDM State Vertex Outputs" counts. -->
    <field name="Output count 1" size="8" start="96" type="uint"/>
    <field name="Output count 2" size="8" start="104" type="uint"/>
    <field name="Output count 3" size="8" start="112" type="uint"/>

    <!-- Apple8 "VDM State Vertex Unknown" (U:2148da178..2148da184). Bits 4
         and 5 are set when RenderPipeline+0x2f0 is zero. -->
    <field name="Flat shading control" size="2" start="128" type="VDM Vertex"/>
    <field name="Unknown 2" size="2" start="130" type="hex"/>
    <field name="Unknown 4" size="1" start="132" type="bool"/>
    <field name="Unknown 5" size="1" start="133" type="bool"/>
    <field name="Generate primitive ID" size="1" start="134" type="bool"/>

    <!-- ([ctx+0x8410] - 1) & 7, zero by default (U:2149c1c38..2149c1c4c). -->
    <field name="Unknown count" size="3" start="160" type="uint" modifier="minus(1)" default="1"/>
  </struct>

  <!-- Indexed draws: index range from the 4-byte aligned start of the index
       data, in 32-bit words minus one (U:2149ee3e8..2149ee3f4, U:2149ee430).
       Apple8 stores the word count without the bias. -->
  <struct name="Apple9 Index List: Buffer size" size="4">
    <field name="Words" size="32" start="0" type="uint" modifier="minus(1)"/>
  </struct>

  <!-- Indexed draws end with bits 40..47 of the index address
       (U:2149ee434, U:2149ee44c). "Index List" carries bits 32..39. -->
  <struct name="Apple9 Index List: Buffer hi" size="4">
    <field name="Address bits 40 to 47" size="8" start="0" type="hex"/>
  </struct>

  <!-- Indirect draws: address bits 32..47, then the low word with bits 0..1
       clear (U:2149ee738..2149ee760). Apple8 has 8 high bits. -->
  <struct name="Apple9 Index List: Indirect buffer" size="8">
    <field name="Address hi" size="16" start="0" type="hex"/>
    <field name="Address lo" size="32" start="32" type="hex"/>
  </struct>

  <!-- A single word; written once at the end of a stream by
       emitEndCommandStream (U:2149c9f38..2149c9f48). -->
  <struct name="Apple9 VDM Stream Terminate" size="4">
    <field name="Block Type" size="3" start="29" type="VDM Block Type" exact="Stream Terminate"/>
  </struct>

  <!--
    PPP records. Native encoder: AGX::PPPEncoderGen6<AGX::HAL200::ESLEncoder,
    AGX::HAL200::VsStateConfig> and the state held in AGX::RenderContext.

    Each record starts with an Apple8 "PPP Header" word and is referenced
    from the VDM stream by a "PPP State" word. The nine records and their
    header constants (U:2149c1c70..2149c21f0):

      varying counts      5 words  0x10040000
      fragment shader     7 words  0x00800000
      output select       5 words  0x0c0a0000
      fragment            7 words  0x010000b4
      fragment 2          5 words  0x02000048
      raster              0xa + 8n 0x00000c00 | n << 12
      W clamp             3 words  0x00410000
      cull                2 words  0x00200000
      depth bias/scissor  2 words  0x00000100

    The fragment and fragment 2 records carry their control word although
    the header bits "Fragment control" / "Fragment control 2" are clear.

    Shared with Apple8: "Fragment control", "Fragment face" (the line width
    is 10 bits wide here), "Fragment stencil", "Fragment occlusion query",
    "Region clip", "Viewport", "W Clamp", "Cull", "Output Select",
    "Depth bias/Scissor".
  -->

  <!-- Four words of three 8-bit counts, built from two tables of the vertex
       shader's compiler reply (U:2148d65b8..2148d68a4). Only the shape is
       known for words 1..3; word 0 has the shape of Apple8 "Varying Counts"
       and is what Mesa fills. -->
  <struct name="Apple9 Varying Counts" size="16">
    <field name="Smooth" size="8" start="0" type="uint"/>
    <field name="Flat" size="8" start="8" type="uint"/>
    <field name="Linear" size="8" start="16" type="uint"/>
    <field name="Count 1 0" size="8" start="32" type="uint"/>
    <field name="Count 1 1" size="8" start="40" type="uint"/>
    <field name="Count 1 2" size="8" start="48" type="uint"/>
    <field name="Count 2 0" size="8" start="64" type="uint"/>
    <field name="Count 2 1" size="8" start="72" type="uint"/>
    <field name="Count 2 2" size="8" start="80" type="uint"/>
    <field name="Count 3 0" size="8" start="96" type="uint"/>
    <field name="Count 3 1" size="8" start="104" type="uint"/>
    <field name="Count 3 2" size="8" start="112" type="uint"/>
  </struct>

  <!-- Six words. The static part is written by
       FragmentProgramVariantESLState::finalize (U:21496a194..21496a1f8) and
       merged with the addresses when emitted (U:214a45e44..214a45ef8). -->
  <struct name="Apple9 Fragment Shader" size="24">
    <!-- Coefficient table address bits 32..47; Apple8 has register counts
         here. -->
    <field name="CF bindings hi" size="16" start="0" type="hex"/>
    <field name="CF binding count" size="7" start="16" type="uint"/>
    <!-- Entries of the first group when a second group exists. -->
    <field name="CF binding count A" size="7" start="24" type="uint"/>

    <field name="CF bindings" size="30" start="34" type="address" modifier="shr(2)"/>

    <!-- The same two compiler-derived word counts as in the vertex state
         block of the VDM stream. -->
    <field name="State load count A" size="12" start="64" type="uint"/>
    <field name="State load count B" size="18" start="99" type="uint"/>

    <!-- GPU address of the fragment state-load program, bits 38..47 and
         6..37. -->
    <field name="State load hi" size="10" start="118" type="hex"/>
    <field name="State load lo" size="32" start="128" type="hex"/>

    <!-- A byte of the compiler reply (U:2149672d4..214967300). -->
    <field name="Unknown" size="4" start="160" type="hex"/>
  </struct>

  <!-- Apple8 "Output Select" with the clip planes as a mask, (1 << n) - 1
       for n planes (U:2148d64f0..2148d6520), and the bits Apple8 lacks
       (U:2148ef4dc..2148ef518, U:2148d654c..2148d6558). -->
  <struct name="Apple9 Output Select" size="4">
    <field name="Clip distance planes" size="8" start="0" type="hex"/>
    <field name="Varyings" size="1" start="16" type="bool"/>
    <field name="Point size" size="1" start="18" type="bool"/>
    <field name="Viewport target" size="1" start="19" type="bool"/>
    <field name="Render target" size="1" start="20" type="bool"/>
    <field name="Frag coord Z" size="1" start="21" type="bool"/>
    <field name="Barycentric coordinates" size="1" start="22" type="bool"/>
    <field name="Barycentric coordinates 2" size="1" start="23" type="bool"/>
    <field name="Unknown 24" size="2" start="24" type="hex"/>
    <field name="Unknown 26" size="2" start="26" type="hex"/>
  </struct>

  <!-- Vertex amplification count, [ctx+0x7fc0] - 1 (U:2149cf238..2149cf244).
       Apple8 calls this word "Output Unknown". -->
  <struct name="Apple9 Output Amplification" size="4">
    <field name="Count" size="3" start="0" type="uint" modifier="minus(1)" default="1"/>
  </struct>

  <!-- [key+0xc] and [key+0x14] of the vertex program key
       (U:2148d655c..2148d6560). Apple8 has a single 32-bit count. -->
  <struct name="Apple9 Output Size" size="4">
    <field name="Count" size="8" start="0" type="uint"/>
    <field name="Count 2" size="8" start="16" type="uint"/>
  </struct>

  <!-- As Apple8, plus the polygon mode for triangle primitives
       (U:2149c32fc..2149c331c). -->
  <struct name="Apple9 Fragment face 2" size="4">
    <field name="Polygon mode" size="2" start="18" type="Polygon Mode"/>
    <field name="Disable depth write" size="1" start="21" type="bool"/>
    <field name="Conservative depth" size="2" start="22" type="Conservative depth"/>
    <field name="Depth function" size="3" start="24" type="ZS Func"/>
    <field name="Object type" size="4" start="28" type="Object Type"/>
  </struct>

  <!-- Per render target channel write mask, shifted left by eight bits per
       preceding target and cut to 17 bits (U:2148ef2a4..2148ef318). A single
       four-component target with all channels written gives 0x1ffff. -->
  <struct name="Apple9 Fragment occlusion query 2" size="4">
    <field name="Channel write mask" size="17" start="0" type="hex"/>
  </struct>

  <!-- Bit 0: two viewports overlap (U:2148d2228..2148d2314). -->
  <struct name="Apple9 Viewport control" size="4">
    <field name="Overlapping viewports" size="1" start="0" type="bool"/>
  </struct>

  <!-- Initial value 0x80 (U:214a1abf4..214a1abf8). -->
  <struct name="Apple9 Cull 2" size="4">
    <field name="Unknown 7" size="1" start="7" type="bool" default="true"/>
    <field name="Needs Primitive ID" size="1" start="12" type="bool"/>
    <field name="Unknown 13" size="1" start="13" type="bool"/>
    <field name="Rasterizer discard" size="1" start="17" type="bool"/>
  </struct>
</genxml>
